{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.emulators)",
      "Read(**/.envrc)",
      "Read(public/firebase-config.json)",
      "Read(dist/**/firebase-config.json)",
      "Read(**/*serviceAccount*.json)",
      "Read(**/*-firebase-adminsdk-*.json)",
      "Read(**/.firebaserc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(~/.config/firebase/**)",
      "Read(~/.ssh/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Edit(**/.env.emulators)",
      "Edit(**/.envrc)",
      "Edit(public/firebase-config.json)",
      "Edit(**/*serviceAccount*.json)",
      "Edit(**/*-firebase-adminsdk-*.json)",
      "Edit(**/.firebaserc)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Bash(npm start)",
      "Bash(npm run start)",
      "Bash(npm run build)",
      "Bash(npm run build:pages)",
      "Bash(npm run config:firebase)",
      "Bash(npm run start:emulators)",
      "Bash(node scripts/firebase-config.mjs*)",
      "Bash(firebase login*)",
      "Bash(npx firebase-tools* login*)",
      "Bash(npx -y firebase-tools* login*)",
      "Bash(npx -y firebase-tools* deploy*)",
      "Bash(npx firebase-tools* deploy*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-secrets.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}

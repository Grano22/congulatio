{
  "name": "congulatio",
  "version": "0.3.0",
  "description": "Aplikacja do tworzenia postaci np: NPC oraz drzewek dialogowych i interakcji do gry komputerowej typu RPG.",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/firebase-config.mjs && ng serve",
    "build": "node scripts/firebase-config.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "build:pages": "node scripts/firebase-config.mjs && ng build --base-href /congulatio/",
    "config:firebase": "node scripts/firebase-config.mjs",
    "emulators": "npx -y firebase-tools@15.34.2 emulators:start --project demo-congulatio",
    "start:emulators": "ng serve --configuration emulators",
    "e2e": "node e2e/run.mjs"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.3",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/uncial-antiqua": "^5.3.0",
    "@ngrx/signals": "^22.0.1",
    "@primeuix/themes": "^3.0.1",
    "firebase": "^13.1.0",
    "lucide": "^1.59.0",
    "primeng": "^22.1.2",
    "rxjs": "~7.8.0",
    "three": "^0.180.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.6.6",
    "@types/three": "^0.180.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "vite": "8.3.4",
    "fast-uri": "3.1.9"
  }
}
